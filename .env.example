# Spotify (optional): the Client ID can also be pasted in the app (更多 → Spotify 酒单).
# Never put a Client Secret here — the tavern uses PKCE and doesn't need one.
VITE_SPOTIFY_CLIENT_ID=
# Defaults to http://127.0.0.1:5173/callback (register the same address in the Spotify dashboard).
VITE_SPOTIFY_REDIRECT_URI=
VITE_ENABLE_MULTIPLAYER=false
# Optional deployment subdirectory, including leading/trailing slashes.
VITE_BASE_PATH=/
